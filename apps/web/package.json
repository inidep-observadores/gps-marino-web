{
  "name": "@gpsm/web",
  "version": "0.1.0",
  "private": true,
  "description": "GPS Marino Web: PWA de navegación y registro de posiciones a bordo, con SQLite local y uso sin conexión",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@gpsm/shared": "workspace:*",
    "@lucide/vue": "~1.70.0",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "comlink": "^4.4.2",
    "drizzle-orm": "^0.45.4",
    "fflate": "0.8.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.22"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "~5.0.5",
    "vue-tsc": "^3.3.14"
  }
}

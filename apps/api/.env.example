# Copiar a .env (no se versiona). Ver docker-compose.yml en la raíz.
DATABASE_URL=postgresql://gpsm:gpsm@localhost:5437/gpsm
# Mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
# ID de cliente OAuth de Google Cloud (tipo "Aplicación web"). Sin él, el login con Google responde 503.
GOOGLE_CLIENT_ID=
# Origen(es) de la web permitidos por CORS, separados por coma
WEB_ORIGINS=http://localhost:5180
PORT=3000
